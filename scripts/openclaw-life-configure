#!/usr/bin/env python3

import os
import subprocess
import sys


def list_openclaw_dirs(base_dir):
    return sorted(
        [
            d
            for d in os.listdir(base_dir)
            if d.startswith("openclaw-") and os.path.isdir(os.path.join(base_dir, d))
        ]
    )


def backup_entry(name):
    """Return the backup crontab line for an instance."""
    home = os.path.expanduser("~")
    return (
        f"cd {home}/openclaw-life/openclaw-{name} "
        f"&& ../scripts/openclaw-life-git-backup 2>&1 >> {home}/{name}.log"
    )


def openclaw_backup_entries(cron_lines):
    """Yield (name, index, minute) for each existing openclaw backup line."""
    import re

    pat = re.compile(r"openclaw-([\w-]+)\s*&&\s*\.\./scripts/openclaw-life-git-backup")
    for i, line in enumerate(cron_lines):
        m = pat.search(line)
        if m and re.match(r"^\s*\d+\s+3\s+", line):
            minute = int(line.lstrip().split()[0])
            yield m.group(1), i, minute


def install_backup_cron(openclaw_name):
    """Install/update the nightly backup cron entry for this instance,
    scheduling it 5 minutes after the latest existing openclaw backup."""
    import re

    existing = subprocess.run(["crontab", "-l"], capture_output=True, text=True).stdout
    cron_lines = existing.splitlines()

    # Find the latest minute among existing openclaw backup entries.
    minutes = [m for _, _, m in openclaw_backup_entries(cron_lines)]
    minute = (max(minutes) + 5) % 60 if minutes else 30

    # Build the new/updated line for this instance.
    new_line = f"{minute} 3 * * * {backup_entry(openclaw_name)}"

    # Replace an existing entry for this instance, or append a new one.
    replaced = False
    out = []
    for line in cron_lines:
        if re.search(
            rf"openclaw-{re.escape(openclaw_name)}\b\s*&&\s*\.\./scripts/openclaw-life-git-backup",
            line,
        ):
            out.append(new_line)
            replaced = True
        else:
            out.append(line)
    if not replaced:
        out.append(new_line)

    subprocess.run(["crontab", "-"], input="\n".join(out) + "\n", text=True, check=True)
    action = "Updated" if replaced else "Installed"
    print(
        f"{action} nightly backup cron for openclaw-{openclaw_name} "
        f"at 03:{minute:02d} (5 min after the previous backup)"
    )


def select_instance_dir(base_dir):
    dirs = list_openclaw_dirs(base_dir)
    if not dirs:
        print("No openclaw-* directories found. Exiting.")
        exit(1)
    print("Select an openclaw instance:")
    for idx, d in enumerate(dirs, 1):
        print(f"  {idx}. {d}")
    while True:
        choice = input(f"Enter number (1-{len(dirs)}): ").strip()
        if choice.isdigit() and 1 <= int(choice) <= len(dirs):
            return os.path.join(base_dir, dirs[int(choice) - 1])
        print("Invalid selection. Try again.")


def main():
    base_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
    if len(sys.argv) > 1:
        instance_dir = os.path.join(base_dir, sys.argv[1])
        if not os.path.isdir(instance_dir):
            print(f"Directory {instance_dir} does not exist. Exiting.")
            exit(1)
    else:
        instance_dir = select_instance_dir(base_dir)

    example_env_path = os.path.join(instance_dir, "example.env")
    dotenv_path = os.path.join(instance_dir, ".env")

    if not os.path.isfile(example_env_path):
        print(f"example.env not found in {instance_dir}.")
        exit(1)

    # Read existing .env values if present
    existing_env = {}
    if os.path.isfile(dotenv_path):
        with open(dotenv_path, "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                v = v.strip()
                if len(v) > 0:
                    existing_env[k.strip()] = v.strip()
        print(f"Read {len(existing_env)} existing .env values.")
    else:
        print("No existing .env file found. All values will be prompted.")

    # Determine instance name from directory
    instance_basename = os.path.basename(instance_dir)
    openclaw_name = (
        instance_basename.split("-", 1)[1]
        if "-" in instance_basename
        else instance_basename
    )

    new_env_lines = []

    def prompt_with_default(prompt, default=None):
        if default:
            prompt = f"{prompt} [default: {default}]: "
        else:
            prompt = f"{prompt}: "
        user_input = input(prompt).strip()
        if user_input:
            return user_input
        return default

    uid_default = str(os.getuid())
    gid_default = str(os.getgid())

    with open(example_env_path, "r") as f:
        lines = f.readlines()

    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            new_env_lines.append(line)
            continue
        if "=" not in line:
            new_env_lines.append(line)
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()

        # Determine the default value: prefer .env, then example.env, then UID/GID for those keys
        if key == "UID":
            default = existing_env.get("UID", value or uid_default)
        elif key == "GID":
            default = existing_env.get("GID", value or gid_default)
        else:
            default = existing_env.get(key, value)

        # Custom handling for specific variables
        if key == "OPENCLAW_NAME":
            print(
                f"Setting OPENCLAW_NAME to '{openclaw_name}' based on directory name."
            )
            new_env_lines.append(f"OPENCLAW_NAME={openclaw_name}\n")
        elif key == "OPENCLAW_GATEWAY_TOKEN":
            prompt = "Enter value for OPENCLAW_GATEWAY_TOKEN"
            if not default:
                prompt += " (leave blank to autogenerate)"
            user_value = prompt_with_default(prompt, default)
            if user_value:
                new_env_lines.append(f"OPENCLAW_GATEWAY_TOKEN={user_value}\n")
            elif default:
                new_env_lines.append(f"OPENCLAW_GATEWAY_TOKEN={default}\n")
            else:
                try:
                    token = (
                        subprocess.check_output(["openssl", "rand", "-hex", "32"])
                        .decode()
                        .strip()
                    )
                    print(f"Autogenerated OPENCLAW_GATEWAY_TOKEN: {token}")
                    new_env_lines.append(f"OPENCLAW_GATEWAY_TOKEN={token}\n")
                except Exception as e:
                    print(f"Failed to generate token: {e}")
                    new_env_lines.append(f"OPENCLAW_GATEWAY_TOKEN=\n")
        elif key == "UID":
            user_value = prompt_with_default("Enter UID for OpenClaw process", default)
            new_env_lines.append(f"UID={user_value}\n")
        elif key == "GID":
            user_value = prompt_with_default("Enter GID for OpenClaw process", default)
            new_env_lines.append(f"GID={user_value}\n")
        else:
            user_value = prompt_with_default(f"Enter value for {key}", default)
            if user_value is not None:
                new_env_lines.append(f"{key}={user_value}\n")
            else:
                new_env_lines.append(f"{key}=\n")

    with open(dotenv_path, "w") as f:
        f.writelines(new_env_lines)

    print(f".env file created at {dotenv_path}")

    # Ensure the nightly backup cron exists for this instance. Re-running
    # configure repairs the entry (e.g. after a cron break) and picks the
    # next free 5-minute slot.
    install_backup_cron(openclaw_name)

    print(f"\nOptional next steps:")
    print(
        f"  1. Start the container: cd openclaw-{openclaw_name} && docker compose up -d"
    )
    print(f"  2. If this 'claw needs Google services (Gmail, Calendar, Drive, etc.):")
    print(
        f"     - Place a client_secret_*.json in ~/.openclaw-life/data/openclaw-{openclaw_name}/"
    )
    print(f"     - Run: ../scripts/openclaw-life-gog-auth openclaw-{openclaw_name}")
    print(f"     See docs/gog-auth-setup.md for details.")


if __name__ == "__main__":
    main()
